*.key
*.pem

# Dependencies
node_modules/

# Build output
dist/
build/
out/

# Next.js
.next/
*.tsbuildinfo

# WASM build output (root only, not fixtures)
/*.wasm

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/settings.json

# SQLite databases (runtime data, not source)
*.db
*.db-journal
