*.db-shm

# Orchestration runtime state (not needed by contributors)
.claude-flow/
.swarm/
.ruflo-state/

# Vendored tarballs
vendor/

# SQLite memory files (runtime)
:memory:

# AgentSentry hook-written runtime data (NEVER track these)
agent-sentry/dashboard/data/*.json

# Claude-flow in subpackages
agent-sentry/.claude-flow/

